{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecMi",
  "version": "0.3.0",
  "identifier": "com.miu.recmi",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RecMi",
        "width": 580,
        "height": 278,
        "minWidth": 580,
        "minHeight": 278,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false
      },
      {
        "label": "indicator",
        "title": "Recording \u00b7 RecMi",
        "url": "indicator.html",
        "width": 206,
        "height": 48,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
